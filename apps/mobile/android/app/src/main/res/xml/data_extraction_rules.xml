<?xml version="1.0" encoding="utf-8"?>
<!-- Tokens e segredo do aparelho nunca vão para backup nem para outro aparelho
     (ADR 0012, docs/SEGURANCA.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
